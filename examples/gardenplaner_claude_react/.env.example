# Verschlüsselungsschlüssel für sensible Einstellungen (z.B. api.key)
# Muss genau 32 Bytes = 64 Hex-Zeichen sein.
# Generieren (Terminal): node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Wichtig: .env führt keine Shell-Befehle aus.
# Nicht so eintragen: APP_ENCRYPTION_KEY=$(node -e "...")
APP_ENCRYPTION_KEY=ersetze_dies_mit_64_hex_zeichen_zufallsschluessel_hier

# Optional: Server-Port (Standard: 3001)
# PORT=3001
